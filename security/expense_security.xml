<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Employee Group -->
    <record id="group_expense_user" model="res.groups">
        <field name="name">Expense User</field>
        <field name="category_id"
               ref="base.module_category_human_resources"/>
    </record>

    <!-- Manager Group -->
    <record id="group_expense_manager" model="res.groups">
        <field name="name">Expense Manager</field>
        <field name="category_id"
               ref="base.module_category_human_resources"/>
        <field name="implied_ids"
               eval="[(4, ref('group_expense_user'))]"/>
    </record>

    <!-- Employee Record Rule -->
    <record id="rule_expense_user" model="ir.rule">
        <field name="name">Employees: Own Expenses</field>
        <field name="model_id"
               ref="model_employee_expense"/>
        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups"
               eval="[(4, ref('group_expense_user'))]"/>
    </record>

    <!-- Manager Record Rule -->
    <record id="rule_expense_manager" model="ir.rule">
        <field name="name">Managers: All Expenses</field>
        <field name="model_id"
               ref="model_employee_expense"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('group_expense_manager'))]"/>
    </record>

</odoo>